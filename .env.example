# Wasi — privadas, nunca se exponen al cliente (manual §5.1)
NUXT_WASI_ID_COMPANY=
NUXT_WASI_TOKEN=

# n8n enruta correo, CRM y WhatsApp de los formularios (§8.1)
NUXT_N8N_WEBHOOK_URL=

# Cloudflare R2 — evidencias (fotos y video) de los reportes de mantenimiento.
#
# Son privadas: el navegador nunca las ve. Sube los archivos con una URL que
# firma el servidor y caduca a los cinco minutos. Sin las cuatro, el formulario
# funciona igual pero sin adjuntos, y lo dice en pantalla.
#
# Dónde sale cada una, en el panel de Cloudflare (R2 > tu bucket):
#
#   ENDPOINT   Pestaña Settings, bloque "S3 API". Es la URL SIN el nombre del
#              bucket al final. Si creaste el bucket con jurisdicción, copia el
#              endpoint específico de esa jurisdicción (lleva `.eu.` en medio).
#   BUCKET     El nombre del bucket, a secas.
#   LLAVES     R2 > Manage API tokens > Create API token, con permiso de
#              lectura y escritura sobre este bucket. Al crearlo Cloudflare
#              muestra tres valores: usa "Access Key ID" y "Secret Access Key".
#              El tercero, "Token value", NO se usa aquí: ese sirve para la API
#              de Cloudflare, no para S3.
#   REGION     `auto` para un bucket normal. Si el endpoint lleva jurisdicción,
#              pon la jurisdicción (`eu`), o la firma no cuadra y R2 responde
#              403 sin explicar por qué.
#
NUXT_R2_ENDPOINT=https://ID-DE-TU-CUENTA.r2.cloudflarestorage.com
NUXT_R2_BUCKET=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_REGION=auto

# Antispam (§8.4)
NUXT_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Públicas
NUXT_PUBLIC_SITE_URL=https://inmobarco.com
NUXT_PUBLIC_GTAG_ID=

# Solo desarrollo: pone a la vista los formularios antes de que existan las
# páginas legales. En el build de producción no tiene ningún efecto.
NUXT_PUBLIC_FORMS_PREVIEW=true
